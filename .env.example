# Configure these as server-side secrets. Never use NEXT_PUBLIC_ or VITE_ prefixes.
# Leave both Supabase fields unset to use the clearly labelled sample dataset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Offline questions work without a Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
